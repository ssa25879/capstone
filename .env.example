# 이 파일을 .env로 복사해 값을 채웁니다. (.env는 Git에 올라가지 않습니다)
# 아무것도 지정하지 않으면 로컬 SQLite + 로컬 uploads 폴더로 동작합니다.

# ── Supabase Postgres ─────────────────────────────
# 대시보드 Connect > Session pooler 연결 문자열 (비밀번호 포함, 절대 커밋 금지)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 대시보드 Database Settings > SSL Configuration에서 받은 인증서 파일 경로 또는 PEM 내용
# DATABASE_CA_CERT=./prod-ca-2021.crt

# ── Supabase Storage (업로드 이미지) ───────────────
# 대시보드 Project Settings > API의 Project URL과 service_role 키 (서버 전용, 절대 커밋·노출 금지)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=uploads

# ── 서버 ───────────────────────────────────────────
# PORT=3000
# 지정하면 서버를 재시작해도 로그인이 유지됩니다. 긴 무작위 문자열을 사용하세요.
# SESSION_SECRET=
